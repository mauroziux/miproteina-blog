---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import categories from '../../data/categories.json';

export async function getStaticPaths() {
  const now = new Date();
  const posts = (await getCollection('blog')).filter((post) => post.data.pubDate <= now);
  const categoryNames = [...new Set(posts.map((p) => p.data.category))];
  return categoryNames.map((cat) => {
    const catPosts = posts.filter((p) => p.data.category === cat);
    const catData = categories.find((c) => c.name === cat);
    const slug = catData?.slug || cat.toLowerCase().replace(/\s+/g, '-');
    return {
      params: { slug },
      props: { name: cat, posts: catPosts },
    };
  });
}

const { name, posts } = Astro.props;
const sortedPosts = posts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title={`${name} - Blog Mi Proteína`} description={`Artículos sobre ${name} - Blog Mi Proteína`}>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <header class="mb-10">
      <nav class="text-sm text-[var(--color-brand-gray-500)] mb-2">
        <a href="/" class="hover:text-[var(--color-primary)]">Inicio</a>
        <span class="mx-1">/</span>
        <span>Categoría</span>
        <span class="mx-1">/</span>
        <span class="text-[var(--color-brand-black)]">{name}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-[var(--color-brand-black)]">{name}</h1>
      <p class="mt-2 text-[var(--color-brand-gray-500)]">
        {sortedPosts.length} artículo{sortedPosts.length !== 1 ? 's' : ''} en esta categoría
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
