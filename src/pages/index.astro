---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Get unique categories for the nav
const categories = [...new Set(posts.map((p) => p.data.category))];

// Featured = latest post
const featured = posts[0];
const rest = posts.slice(1);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero / Featured post -->
  {featured && (
    <section class="max-w-5xl mx-auto px-4 pt-12 pb-8">
      <a href={`/${featured.data.wpSlug}/`} class="group block">
        <div class="relative overflow-hidden rounded-2xl">
          {featured.data.heroImage && (
            <img
              src={typeof featured.data.heroImage === 'string'
                ? featured.data.heroImage
                : featured.data.heroImage.src}
              alt={featured.data.title}
              class="w-full h-64 md:h-96 object-cover transition-transform duration-300 group-hover:scale-105"
              loading="eager"
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 text-white">
            <span class="inline-block bg-[var(--color-primary)] text-white text-xs font-semibold px-3 py-1 rounded-full mb-3">
              {featured.data.category}
            </span>
            <h2 class="text-2xl md:text-4xl font-bold leading-tight mb-2">
              {featured.data.title}
            </h2>
            <p class="text-white/80 text-sm md:text-base line-clamp-2 max-w-2xl">
              {featured.data.description}
            </p>
          </div>
        </div>
      </a>
    </section>
  )}

  <!-- Category pills -->
  <section class="max-w-5xl mx-auto px-4 pb-6">
    <div class="flex flex-wrap gap-2">
      <a href="/" class="px-4 py-1.5 rounded-full text-sm font-medium bg-[var(--color-brand-black)] text-white">
        Todos
      </a>
      {categories.slice(0, 8).map((cat) => {
        // Derive slug from category name
        const catSlug = cat.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
        return (
          <a
            href={`/category/${catSlug}`}
            class="px-4 py-1.5 rounded-full text-sm font-medium bg-[var(--color-brand-gray-200)] text-[var(--color-brand-gray-900)] hover:bg-[var(--color-primary)] hover:text-white transition-colors"
          >
            {cat}
          </a>
        );
      })}
    </div>
  </section>

  <!-- Post grid -->
  <section class="max-w-5xl mx-auto px-4 pb-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {rest.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
