---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>404 — Página no encontrada | {SITE_TITLE}</title>
    <meta name="robots" content="noindex, follow" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 flex items-center justify-center px-4">
      <div class="text-center py-20">
        <h1 class="text-6xl font-bold text-[var(--color-brand-gray-200)]">404</h1>
        <p class="mt-4 text-xl text-[var(--color-brand-gray-500)]">Página no encontrada</p>
        <p class="mt-2 text-sm text-[var(--color-brand-gray-400)]">El artículo que buscas no existe o fue eliminado.</p>
        <a href="/" class="mt-6 inline-block px-6 py-2 rounded-full text-sm font-semibold text-white bg-[var(--color-primary)] hover:brightness-105 transition">Volver al inicio</a>
      </div>
    </main>
    <Footer />
  </body>
</html>
